{
  "name": "hush",
  "version": "1.0.5",
  "description": "Unbound edge native voice engine - 100% local",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"import('fs').then(m => m.copyFileSync('electron/preload.cjs', 'dist-electron/preload.cjs'))\"",
    "build:engine": ".\\.venv\\Scripts\\pyinstaller.exe packaging/engine/engine.spec --noconfirm",
    "build:all": "npm run build && npm run build:electron",
    "start": "electron .",
    "app": "concurrently -k \"vite\" \"npm run build:electron && electron .\"",
    "package:win": "npm run build:all && npm run build:engine && electron-builder --win"
  },
  "keywords": [
    "dictation",
    "whisper",
    "speech-to-text",
    "offline",
    "openvino",
    "electron"
  ],
  "author": "Yash Avsarmal",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
